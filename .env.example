# Local deployment settings. Copy to .env before running ./deploy.sh locally.
# CI deployments (OPENSHIFT_CI=true) get these from Vault instead.

# Keycloak values are written by the deployment itself; leave empty.
export KEYCLOAK_CLIENT_SECRET=""
export KEYCLOAK_CLIENT_ID=""
export KEYCLOAK_REALM=""
export KEYCLOAK_LOGIN_REALM=""
export KEYCLOAK_METADATA_URL=""
export KEYCLOAK_BASE_URL=""

# Shared infrastructure namespaces.
export KEYCLOAK_NS="rhdh-keycloak"
export OPERATOR_NAMESPACE="rhdh-operator"

# Optional plugin catalog override (registry/repository:tag or @sha256:digest).
# Leave empty to use the catalog bundled with the selected Helm chart or Operator.
export CATALOG_INDEX_IMAGE="${CATALOG_INDEX_IMAGE:-}"
export CATALOG_INDEX_TAG="${CATALOG_INDEX_TAG:-}"

# Optional RHDH image override (e.g. quay.io/rhdh-community/rhdh:pr-1234).
export RHDH_IMAGE="${RHDH_IMAGE:-}"

# Optional GitHub token. Enables private catalog locations, bulk import and
# write operations; public access is the default.
export GITHUB_TOKEN="${GITHUB_TOKEN:-}"

# Optional Scorecard credential for private SonarQube/SonarCloud data.
export SONARQUBE_API_KEY="${SONARQUBE_API_KEY:-}"

# Optional MCP token override. Generated by the deployment when empty.
export MCP_TOKEN="${MCP_TOKEN:-}"

# Intelligent Assistant (PLUGINS=intelligent-assistant)
# Enable at least one provider and set its credentials.
export ENABLE_OPENAI=""
export OPENAI_API_KEY=""
export ENABLE_VLLM=""
export VLLM_URL=""
export VLLM_API_KEY=""
export VLLM_MAX_TOKENS=""
export VLLM_TLS_VERIFY=""
export ENABLE_OLLAMA=""
export OLLAMA_URL=""
export ENABLE_VERTEX_AI=""
export VERTEX_AI_PROJECT=""
export VERTEX_AI_LOCATION=""

# Optional existing Lightspeed Core stack file. When supplied it is used as-is
# (OKP is not supported; use the no-OKP stack as the base).
export INTELLIGENT_ASSISTANT_STACK_FILE=""
